diff --git a/include/firebolt/actions.h b/include/firebolt/actions.h
new file mode 100644
index 0000000..baafdd4
--- /dev/null
+++ b/include/firebolt/actions.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <firebolt/types.h>
+#include <functional>
+#include <string>
+
+namespace Firebolt::Actions
+{
+class IActions
+{
+public:
+    virtual ~IActions() = default;
+
+    /**
+     * @brief Retrieve the last intent delivered to the calling application
+     *
+     * @retval The last known intent, or an empty string if none is set
+     */
+    virtual Result<std::string> intent() const = 0;
+
+    /**
+     * @brief Subscribe to intent events delivered to the calling application
+     *
+     * @param notification : The callback function, which receives the intent payload
+     *
+     * @retval The subscriptionId or error
+     */
+    virtual Result<SubscriptionId>
+    subscribeOnIntent(std::function<void(const std::string&)>&& notification) = 0;
+
+    /**
+     * @brief Remove subscriber from subscribers list. This method is generic for
+     *        all subscriptions
+     *
+     * @param[in] id : The subscription id
+     *
+     * @retval The status
+     */
+    virtual Result<void> unsubscribe(SubscriptionId id) = 0;
+
+    /**
+     * @brief Remove all active subscriptions from subscribers list.
+     */
+    virtual void unsubscribeAll() = 0;
+};
+} // namespace Firebolt::Actions
