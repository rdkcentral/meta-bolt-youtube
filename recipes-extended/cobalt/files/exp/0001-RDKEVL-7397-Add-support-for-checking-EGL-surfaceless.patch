+  const size_t len = strlen(extension);
+  if (len == 0) {
+    return false;
+  }
   const char* ptr = extension_list;
   while ((ptr = strstr(ptr, extension))) {
-    if (ptr[len] == ' ' || ptr[len] == '\0')
+    const bool start_ok = (ptr == extension_list) || (ptr[-1] == ' ');
+    const bool end_ok = (ptr[len] == ' ' || ptr[len] == '\0');
+    if (start_ok && end_ok)
       return true;
     ptr += len;
   }
   return false;
 }
 
