-#define SB_PLATFORM_MODEL_NAME "RDKReference"
+#define SB_PLATFORM_OPERATOR_NAME "RDKCommonPort"
+#define SB_PLATFORM_MANUFACTURER_NAME "RDKCommonPort"
+#define SB_PLATFORM_MODEL_YEAR 2026
+#define SB_PLATFORM_MODEL_NAME "BCM74166SFF"
 #define SB_PLATFORM_FIRMWARE_VERSION_STRING "1.0.0"
 
