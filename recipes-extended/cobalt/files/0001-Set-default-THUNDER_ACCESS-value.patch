From ee2c55f960b18ff0736020501976de9d14f62e9f Mon Sep 17 00:00:00 2001
From: Adam Stolcenburg <adam_stolcenburg@comcast.com>
Date: Mon, 22 Jun 2026 22:03:08 +0200
Subject: [PATCH] Set default THUNDER_ACCESS value

This enables 4k playback

Ref: #RDKEAPPRT-782
---
 src/third_party/starboard/rdk/shared/rdkservices.cc | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/third_party/starboard/rdk/shared/rdkservices.cc b/src/third_party/starboard/rdk/shared/rdkservices.cc
index 6536137..f9f683d 100644
--- a/src/third_party/starboard/rdk/shared/rdkservices.cc
+++ b/src/third_party/starboard/rdk/shared/rdkservices.cc
@@ -193,6 +193,7 @@ public:
 
   bool EnsureLink() {
     if (!link_) {
+      setenv("THUNDER_ACCESS", "127.0.0.1:9998", 0);
       static const bool kHasThunderAccessEnv = (getenv("THUNDER_ACCESS") != nullptr);
       if (kHasThunderAccessEnv)
         link_.reset(new JSONRPC::LinkType<Core::JSON::IElement>(callsign_, nullptr, false, buildQuery()));
-- 
