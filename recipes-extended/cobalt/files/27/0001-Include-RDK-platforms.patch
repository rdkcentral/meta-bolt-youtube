From: Ievgen Mutavchi <Ievgen_Mutavchi@comcast.com>
Date: Wed, 23 Nov 2022 12:54:37 -0500
Subject: [PATCH] Include RDK platforms

---
 starboard/build/platforms.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/starboard/build/platforms.py b/starboard/build/platforms.py
index a39188e26dca..353d8cb31e39 100644
--- a/starboard/build/platforms.py
+++ b/starboard/build/platforms.py
@@ -24,6 +24,8 @@ except ImportError:
   INTERNAL_PLATFORMS = {}
 
 PLATFORMS = {
+    'rdk-arm': 'third_party/starboard/rdk/arm',
+    'rdk-arm64': 'third_party/starboard/rdk/arm64',
     'stub': 'starboard/stub',
     'linux-x64x11': 'starboard/linux/x64x11',
     'linux-x64x11-egl': 'starboard/linux/x64x11/egl',
@@ -34,7 +36,6 @@ PLATFORMS = {
     'android-arm64': 'starboard/android/arm64',
     'android-x86': 'starboard/android/x86',
     'aosp-arm': 'starboard/aosp/arm',
-    'rdk-arm': 'starboard/contrib/rdk/src/third_party/starboard/rdk/arm',
     'evergreen-x64': 'starboard/evergreen/x64',
     'evergreen-arm-hardfp': 'starboard/evergreen/arm/hardfp',
     'evergreen-arm-softfp': 'starboard/evergreen/arm/softfp',
