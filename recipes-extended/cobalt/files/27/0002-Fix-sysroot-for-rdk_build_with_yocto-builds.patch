From 1cf0ac6225d3c367f3aca81ee44764199f21a09b Mon Sep 17 00:00:00 2001
From: Adam Stolcenburg <adam_stolcenburg@comcast.com>
Date: Wed, 29 Jul 2026 22:26:49 +0200
Subject: [PATCH 2/4] Fix sysroot for rdk_build_with_yocto builds

Set sysroot path from RDK_HOME environment variable when
rdk_build_with_yocto is equal to true.
---
 starboard/build/config/linux/rdk/config_variables.gni      | 7 ++++++-
 .../starboard/rdk/shared/build/rdk_toolchain.gni           | 4 ----
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/starboard/build/config/linux/rdk/config_variables.gni b/starboard/build/config/linux/rdk/config_variables.gni
index b246abc96e68..4336959d46e3 100644
--- a/starboard/build/config/linux/rdk/config_variables.gni
+++ b/starboard/build/config/linux/rdk/config_variables.gni
@@ -15,10 +15,15 @@
 declare_args() {
   rdk_starboard_root = "/"
   rdk_arm_call_convention = "hardfp"
+  rdk_build_with_yocto = true
 }
 
 rdk_home_dir = getenv("RDK_HOME")
 assert(rdk_home_dir != "",
        "RDK builds require the 'RDK_HOME' environment variable to be set.")
 
-rdk_sysroot = "$rdk_home_dir/sysroots/aarch64-rdk-linux"
+if (rdk_build_with_yocto) {
+  rdk_sysroot = rdk_home_dir
+} else {
+  rdk_sysroot = "$rdk_home_dir/sysroots/aarch64-rdk-linux"
+}
diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/build/rdk_toolchain.gni b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/build/rdk_toolchain.gni
index b706b7ae70db..88f4c88fd9fd 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/build/rdk_toolchain.gni
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/shared/build/rdk_toolchain.gni
@@ -31,10 +31,6 @@
 import("//starboard/build/config/linux/rdk/config_variables.gni")
 import("//build/toolchain/gcc_toolchain.gni")
 
-declare_args() {
-  rdk_build_with_yocto = true
-}
-
 template("rdk_gcc_toolchain") {
   gcc_toolchain(target_name) {
     if (rdk_build_with_yocto) {
-- 
