+#pragma once
+
+#include "starboard/configuration.h"
+
+#include "third_party/starboard/rdk/shared/uri.h"
+
+#include <firebolt/firebolt.h>
+#include <optional>
+#include <variant>
+
+namespace third_party {
+namespace starboard {
+namespace rdk {
+namespace shared {
+namespace platform {
+
+struct IntentParams {
+
+  enum class Action : uint32_t {
+    Other,
+    PreLoad,
+    Home,
+    Launch,
+    Search,
+    PlayEntity,
+    PlayQuery,
+    SkipAd,
+    Next,
+    Previous,
+  };
+
+  enum class Source : uint32_t {
+    Other,
+    Voice,
+    Editorial,
+    Dial,
+    System,
+    AppsRail,
+    Remote,
+  };
+
+  enum class EntityType : uint32_t {
+    Other,
+    Playlist
+  };
+
+  struct Context {
+    Source source;
+    std::optional<bool> in_app;
+  };
+
+  struct QueryData {
+    std::string query;
+  };
+
+  struct PlayEntityData {
+    struct {
+      std::string entityId;
+      EntityType entityType;
+    } entity;
+  };
+
+  struct DialData {
+    std::string dialPayload;
+    std::string additionalDataUrl;
+  };
+
+  using Data = std::variant<std::monostate,QueryData,PlayEntityData,DialData>;
+
+  Action action;
+  Context context;
+  std::optional<Data> data;
+
+  bool isValid() const;
+  UriQuery toUriQuery(bool is_focused) const;
+
+  static Firebolt::Result<IntentParams> fromString(std::string_view json);
+
+private:
+  IntentParams() = default;
+};
+
+}  // namespace platform
+}  // namespace shared
+}  // namespace rdk
+}  // namespace starboard
+}  // namespace third_party
