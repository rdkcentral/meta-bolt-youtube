From 31c2bd0505d507ed4c69f05b4ce38189bc36dc50 Mon Sep 17 00:00:00 2001
From: Adam Stolcenburg <adam_stolcenburg@comcast.com>
Date: Wed, 29 Jul 2026 22:16:47 +0200
Subject: [PATCH 1/4] Fix assignment with no effect for rdk_build_with_yocto
 builds

---
 .../src/third_party/starboard/rdk/arm/toolchain/BUILD.gn  | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/starboard/contrib/rdk/src/third_party/starboard/rdk/arm/toolchain/BUILD.gn b/starboard/contrib/rdk/src/third_party/starboard/rdk/arm/toolchain/BUILD.gn
index 9c6d5b712072..f0e6ded5b363 100644
--- a/starboard/contrib/rdk/src/third_party/starboard/rdk/arm/toolchain/BUILD.gn
+++ b/starboard/contrib/rdk/src/third_party/starboard/rdk/arm/toolchain/BUILD.gn
@@ -33,12 +33,10 @@ import("//cobalt/build/configs/hacks.gni")
 import("//starboard/build/toolchain/cobalt_toolchains.gni")
 import("$rdk_starboard_root/third_party/starboard/rdk/shared/build/rdk_toolchain.gni")
 
-_rdk_toolchain_path = "$rdk_home_dir/sysroots/x86_64-rdksdk-linux/usr/bin/arm-rdkmllib32-linux-gnueabi"
-_rdk_toolchain_toolprefix = "$_rdk_toolchain_path/arm-rdkmllib32-linux-gnueabi-"
-_rdk_toolchain_platform_cflags = ""
-
 if (!rdk_build_with_yocto) {
-  _rdk_toolchain_platform_cflags += "-march=armv7-a -mthumb -mfpu=neon"
+  _rdk_toolchain_path = "$rdk_home_dir/sysroots/x86_64-rdksdk-linux/usr/bin/arm-rdkmllib32-linux-gnueabi"
+  _rdk_toolchain_toolprefix = "$_rdk_toolchain_path/arm-rdkmllib32-linux-gnueabi-"
+  _rdk_toolchain_platform_cflags = "-march=armv7-a -mthumb -mfpu=neon"
   if (rdk_arm_call_convention == "softfp") {
     _rdk_toolchain_platform_cflags += " -mfloat-abi=softfp"
   } else {
